{
  "manifest_version": 3,
  "name": "Vinland",
  "version": "19.35",
  "description": "Vinland Command Interface - Terminal New Tab By Rhyon",
  "icons": {
    "16": "assets/brand/v2-icon-16.png",
    "48": "assets/brand/v2-icon-48.png",
    "128": "assets/brand/v2-icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "bookmarks",
    "storage",
    "unlimitedStorage",
    "notifications",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtube-nocookie.com/*"
  ],
  "background": {
    "service_worker": "js/background/service-worker.js",
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https: data: blob:; media-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; frame-src 'self' https://*.youtube.com https://*.youtube-nocookie.com https://docs.google.com;"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "background.mp4",
        "assets/brand/favicon.svg",
        "assets/brand/v2-icon-16.png",
        "assets/brand/v2-icon-48.png",
        "assets/brand/v2-icon-128.png",
        "*.jpg",
        "*.png",
        "*.gif",
        "*.webp"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
